  # - gemini-user
  # - antigravity-user
  # - antigravity-cli
  # - hermes-user

  # Project-scoped examples:
  # - claude-project
  # - agents-project
  # - copilot-project   # Writes into the repository under .github/skills
  # - opencode-project
  # - gemini-workspace
  # - antigravity-workspace

