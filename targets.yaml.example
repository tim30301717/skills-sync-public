# Copy to targets.yaml in a tool repo or hub, then enable the profiles you want.
# The CLI reads targets.yaml from the selected hub.

profiles:
  # Portable defaults for shared team use:
  - claude-user
  # - agents-user       # Recommended shared target for GitHub Copilot
  # - copilot-user      # Copilot-only personal target; don't enable with agents-user
